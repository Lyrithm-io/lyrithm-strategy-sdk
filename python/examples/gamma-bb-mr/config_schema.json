{
  "title": "Lyrid γ · Bollinger Mean-Reversion",
  "groups": [
    {
      "name": "Bollinger Bands",
      "fields": {
        "bb_length": { "type": "integer", "min": 10,  "max": 50,   "default": 20,   "label": "BB Length",          "tunable": true },
        "bb_stdev":  { "type": "number",  "min": 1.0, "max": 3.0,  "default": 2.0,  "label": "BB StDev (σ ×)",     "tunable": true }
      }
    },
    {
      "name": "RSI",
      "fields": {
        "rsi_period":   { "type": "integer", "min": 2,  "max": 50, "default": 14, "label": "RSI Period",            "tunable": true },
        "rsi_oversold": { "type": "integer", "min": 10, "max": 60, "default": 40, "label": "RSI Oversold (BUY <)",  "tunable": true }
      }
    },
    {
      "name": "Trend + Regime",
      "fields": {
        "ema_length":     { "type": "integer", "min": 50,  "max": 300, "default": 100,  "label": "EMA Period",                       "tunable": true },
        "trend_buffer":   { "type": "number",  "min": 0.8, "max": 1.0, "default": 0.95, "label": "Trend Buffer (close > EMA × x)",   "tunable": true },
        "range_band_pct": { "type": "number",  "min": 0.01, "max": 0.2, "default": 0.08, "label": "Range Band (|c−EMA|/EMA <)",      "tunable": true }
      }
    },
    {
      "name": "Risk",
      "fields": {
        "stop_loss_pct":   { "type": "number",  "min": 0.005, "max": 0.10, "default": 0.025, "label": "Stop Loss %",   "tunable": true },
        "take_profit_pct": { "type": "number",  "min": 0.005, "max": 0.15, "default": 0.05,  "label": "Take Profit %", "tunable": true },
        "leverage":        { "type": "integer", "min": 1,     "max": 50,   "default": 5,     "label": "Leverage",      "tunable": true }
      }
    }
  ]
}
