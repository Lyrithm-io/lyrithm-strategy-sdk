{
  "title": "RSI Mean Reversion",
  "groups": [
    {
      "name": "RSI",
      "fields": {
        "rsi_period":             { "type": "integer", "min": 2,    "max": 200,   "default": 14,   "label": "RSI period",          "tunable": true },
        "oversold_threshold":     { "type": "number",  "min": 5.0,  "max": 49.0,  "default": 30.0, "label": "Oversold threshold",  "tunable": true },
        "overbought_threshold":   { "type": "number",  "min": 51.0, "max": 95.0,  "default": 70.0, "label": "Overbought threshold","tunable": true }
      }
    },
    {
      "name": "ATR + Risk",
      "fields": {
        "atr_period":    { "type": "integer", "min": 2,   "max": 100,   "default": 14,   "label": "ATR period",    "tunable": true },
        "stop_atr_mult": { "type": "number",  "min": 0.1, "max": 10.0,  "default": 2.0,  "label": "Stop = ATR ×",  "tunable": true },
        "reward_ratio":  { "type": "number",  "min": 0.5, "max": 10.0,  "default": 1.5,  "label": "Reward Ratio",  "tunable": true },
        "leverage":      { "type": "integer", "min": 1,   "max": 50,    "default": 3,    "label": "Leverage",      "tunable": true }
      }
    }
  ]
}
